{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 26,
        "patch": 4
    },
    "configurePresets": [
        {
            "name": "build",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "release",
            "inherits": [
                "ninja",
                "build"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "debug",
            "inherits": [
                "ninja",
                "build"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "tidy",
            "inherits": [
                "release"
            ],
            "cacheVariables": {
                "SOGEN_ENABLE_CLANG_TIDY": "ON",
                "SOGEN_ENABLE_PYTHON_BINDINGS": "ON"
            }
        },
        {
            "name": "asan",
            "inherits": [
                "release"
            ],
            "cacheVariables": {
                "SOGEN_ENABLE_SANITIZER": "ON"
            }
        },
        {
            "name": "ios",
            "inherits": [
                "ninja",
                "build"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/ios.cmake",
                "SOGEN_ENABLE_RUST_CODE": "OFF",
                "SOGEN_USE_SYSTEM_SDL3": "OFF"
            }
        },
        {
            "name": "ios-embed-base",
            "hidden": true,
            "inherits": [
                "ios"
            ],
            "cacheVariables": {
                "SOGEN_BUILD_STATIC": "ON",
                "SOGEN_BUILD_TOOLS": "OFF",
                "SOGEN_ENABLE_LTO": "OFF"
            }
        },
        {
            "name": "ios-embed-device",
            "inherits": [
                "ios-embed-base"
            ]
        },
        {
            "name": "ios-embed-simulator",
            "inherits": [
                "ios-embed-base"
            ],
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/ios-simulator.cmake"
            }
        },
        {
            "name": "emscripten-base",
            "hidden": true,
            "inherits": [
                "ninja"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "SOGEN_ENABLE_RUST_CODE": "OFF"
            },
            "environment": {
                "EMSDK_QUIET": "1"
            }
        },
        {
            "name": "emscripten32",
            "inherits": [
                "emscripten-base"
            ],
            "binaryDir": "${sourceDir}/build/emscripten32"
        },
        {
            "name": "emscripten64",
            "inherits": [
                "emscripten-base"
            ],
            "binaryDir": "${sourceDir}/build/emscripten64",
            "cacheVariables": {
                "SOGEN_EMSCRIPTEN_MEMORY64": "ON"
            }
        },
        {
            "name": "vs2022",
            "generator": "Visual Studio 17 2022",
            "inherits": "build"
        },
        {
            "name": "vs2026",
            "generator": "Visual Studio 18 2026",
            "inherits": "build"
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "tidy",
            "configurePreset": "tidy"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "emscripten32",
            "configurePreset": "emscripten32",
            "targets": [
                "analyzer",
                "linux-analyzer"
            ]
        },
        {
            "name": "emscripten64",
            "configurePreset": "emscripten64",
            "targets": [
                "analyzer",
                "linux-analyzer"
            ]
        },
        {
            "name": "ios",
            "configurePreset": "ios",
            "targets": [
                "analyzer"
            ]
        },
        {
            "name": "ios-embed-device",
            "configurePreset": "ios-embed-device",
            "targets": [
                "windows-emulator",
                "backend-selection",
                "unicorn-emulator",
                "fex-emulator"
            ]
        },
        {
            "name": "ios-embed-simulator",
            "configurePreset": "ios-embed-simulator",
            "targets": [
                "windows-emulator",
                "backend-selection",
                "unicorn-emulator",
                "fex-emulator"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                }
            ]
        },
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "tidy",
            "steps": [
                {
                    "type": "configure",
                    "name": "tidy"
                },
                {
                    "type": "build",
                    "name": "tidy"
                }
            ]
        },
        {
            "name": "emscripten32",
            "steps": [
                {
                    "type": "configure",
                    "name": "emscripten32"
                },
                {
                    "type": "build",
                    "name": "emscripten32"
                }
            ]
        },
        {
            "name": "emscripten64",
            "steps": [
                {
                    "type": "configure",
                    "name": "emscripten64"
                },
                {
                    "type": "build",
                    "name": "emscripten64"
                }
            ]
        },
        {
            "name": "ios",
            "steps": [
                {
                    "type": "configure",
                    "name": "ios"
                },
                {
                    "type": "build",
                    "name": "ios"
                }
            ]
        },
        {
            "name": "ios-embed-device",
            "steps": [
                {
                    "type": "configure",
                    "name": "ios-embed-device"
                },
                {
                    "type": "build",
                    "name": "ios-embed-device"
                }
            ]
        },
        {
            "name": "ios-embed-simulator",
            "steps": [
                {
                    "type": "configure",
                    "name": "ios-embed-simulator"
                },
                {
                    "type": "build",
                    "name": "ios-embed-simulator"
                }
            ]
        }
    ]
}